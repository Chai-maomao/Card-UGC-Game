{
  "name": "cardex-cloudflare-relay",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --ip 127.0.0.1 --port 8791 --inspector-port 0",
    "test": "node --test tests/relay.test.mjs",
    "check": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir .build",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "4.92.0",
    "typescript": "5.9.3",
    "@cloudflare/workers-types": "4.20260515.1"
  },
  "engines": { "node": ">=24" }
}
